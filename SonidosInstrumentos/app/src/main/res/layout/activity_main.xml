<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#FFF8E7">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INSTRUMENTOS MUSICALES"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#333333"/>

    <!-- Nombre del alumno: se asigna en MainActivity desde local.properties -->
    <TextView
        android:id="@+id/txtAlumno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#6D4C41"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="25dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnPiano"
                android:layout_width="150dp"
                android:layout_height="130dp"
                android:src="@drawable/piano"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:contentDescription="Sonido de piano"
                android:padding="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIANO"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnCampana"
                android:layout_width="150dp"
                android:layout_height="130dp"
                android:src="@drawable/campana"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:contentDescription="Sonido de campana"
                android:padding="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAMPANA"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnTambor"
                android:layout_width="150dp"
                android:layout_height="130dp"
                android:src="@drawable/tambor"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:contentDescription="Sonido de tambor"
                android:padding="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAMBOR"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnGuitarra"
                android:layout_width="150dp"
                android:layout_height="130dp"
                android:src="@drawable/guitarra"
                android:scaleType="fitCenter"
                android:background="#FFFFFF"
                android:contentDescription="Sonido de guitarra"
                android:padding="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUITARRA"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toca un instrumento para escucharlo"
        android:textSize="14sp"
        android:textColor="#777777"/>

</LinearLayout>
